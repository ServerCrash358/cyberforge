# HTTPS for the public server. Caddy gets a certificate for {$DOMAIN} from Let's Encrypt and
# renews it, redirects http to https, and forwards everything to the app.
# Access logs are off (Caddy's default): no URL, query string or address is ever written down.
# Owner: A. Filled in by: D1.

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy app:8000
}
