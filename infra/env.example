# Copy to infra/.env on the server and fill in. infra/.env is gitignored: never commit it.

# The public name, for example scam-map.duckdns.org. Caddy gets the HTTPS certificate for it.
DOMAIN=

# A long random secret. Changing it later makes every stored report unreachable, so keep it.
# Make one with:  openssl rand -hex 32
SCAM_MAP_HMAC_KEY=

# Required on POST /admin/reset, so strangers cannot erase the public server.
# Leave empty only for judging, where the PRD wants reset open.  openssl rand -hex 24
SCAM_MAP_ADMIN_TOKEN=
